{
  "name": "cardenveil",
  "private": true,
  "version": "2.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-svelte.mjs",
    "check:types": "svelte-check --tsconfig ./jsconfig.json --output human",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^30.0.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/svelte": "^5.2.8",
    "babel-jest": "^30.0.5",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "sharp": "^0.34.5",
    "supabase": "^2.118.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.7.6",
    "svelte-jester": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@owlbear-rodeo/sdk": "^3.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.1.17",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.17",
    "three": "^0.186.1"
  }
}
